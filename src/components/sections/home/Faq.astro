---
// Figma: Home → 10 FAQ (desktop 4:203, mobile 6:430), FAQ / Item. Відповіді — <details>.
import { Image } from 'astro:assets';
import Button from '../../ui/Button.astro';
import FaqItems from '../../ui/FaqItems.astro';
import photo from '../../../assets/img/home/faq.jpg';
import type { HomeData } from '../../../content.config';

interface Props {
  data: HomeData['faq'];
  href: string;
}
const { data, href } = Astro.props;
---

<section class="faq section" aria-labelledby="faq-title">
  <div class="container faq__row">
    <div class="faq__list">
      <div class="faq__head">
        <div class="section-head__text">
          <p class="eyebrow">{data.eyebrow}</p>
          <h2 id="faq-title">{data.title}</h2>
        </div>
        <Button href={href} variant="accent">
          {data.link.label}
        </Button>
      </div>
      <FaqItems items={data.items} name="faq" />
    </div>
    <div class="faq__img media">
      <Image src={photo} alt={data.image.alt} widths={[520, 1040]} sizes="520px" />
    </div>
  </div>
</section>

<style>
  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .faq__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .faq__img {
    display: none;
  }
  @media (min-width: 1024px) {
    .faq__row {
      display: flex;
      align-items: flex-start;
      gap: var(--space-24);
    }
    .faq__list {
      flex: 1;
    }
    .faq__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .faq__img {
      display: block;
      flex: 0 0 min(36%, 32.5rem);
      aspect-ratio: 520 / 600;
    }
  }
</style>
