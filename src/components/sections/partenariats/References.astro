---
// Figma: Partenariats → 05 Références (desktop 47:524). Логотипи марок — безкінечна стрічка (завдання 30):
// один рядок 80 (mobile 56) на ширину контейнера, краї розчиняються, логотипи пливуть справа наліво
// (~4 с на логотип, пауза при наведенні / фокусі; зменшений рух — статичний ряд). Логотипи світлі монохромні,
// вписані у висоту 32 (mobile 24), не ширші за 9rem. Далі до 2 кейсів. Порожньо — блок схований;
// і логотипів, і кейсів немає — вся секція схована (рішення — на сторінці).
// Кейс: фото 628 × 464 → «GAC · Ambassadeur» → назва кампанії → результати. Немає назви — заголовок =
// марка, мета-рядок не показуємо. Кадр фото (position з даних) — CSS-змінна зі скрипта (CSP).
// Не посилання (сторінок кейсів поки немає) — без зуму.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PartenariatsData } from '../../../content.config';
import { t, type Locale } from '../../../i18n/utils';

interface Props {
  data: PartenariatsData['references'];
  logos: { name: string; image: ImageMetadata }[];
  cases: {
    brand: string;
    type?: string;
    title?: string;
    image: ImageMetadata;
    position?: string;
    alt?: string;
    results: { value: string; label: string }[];
  }[];
  lang: Locale;
  /** Попередній перегляд (dev / збірка з PUBLIC_NOINDEX): порожні тип і результати показуємо
   *  заглушками з Figma («[Type de collaboration]», «[X] k vues»), щоб кейс виглядав завершеним
   *  на презентації. На живому сайті — сховані, як і раніше. */
  preview?: boolean;
}
const { data, logos, cases, lang, preview = false } = Astro.props;
// Лише для перегляду (не реальні тексти сайту) — тому тут, а не в content.
const demo = {
  fr: {
    brand: '[Marque]',
    type: '[Type de collaboration]',
    results: ['vues', 'engagement', 'codes utilisés'],
  },
  en: {
    brand: '[Brand]',
    type: '[Type of collaboration]',
    results: ['views', 'engagement', 'codes used'],
  },
  it: {
    brand: '[Marchio]',
    type: '[Tipo di collaborazione]',
    results: ['visualizzazioni', 'engagement', 'codici usati'],
  },
}[lang];
const items = cases.map((c) => {
  const title = c.title?.trim() || c.brand;
  const type = c.type?.trim() || (preview ? demo.type : '');
  // Мета-рядок: марка · тип. Заголовок = марка → у мета-рядку марку не дублюємо (у перегляді — «[Marque]», як у Figma).
  const brand = c.title?.trim() ? c.brand : preview ? demo.brand : '';
  const meta = [brand, type].filter(Boolean).join(' · ');
  const results =
    c.results.length || !preview
      ? c.results
      : [
          { value: '[X] k', label: demo.results[0] },
          { value: '[X] %', label: demo.results[1] },
          { value: '[X]', label: demo.results[2] },
        ];
  return { ...c, title, meta, results };
});
// Стрічка: мало логотипів — повторюємо набір, щоб він був ширшим за контейнер (на збірці, без JS).
const set = logos.length
  ? Array.from({ length: Math.ceil(10 / logos.length) }, () => logos).flat()
  : [];
---

<section class="refs section" aria-labelledby="refs-title">
  <div class="container refs__inner">
    <div class="section-head__text">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2 id="refs-title">{data.title}</h2>
    </div>

    {set.length > 0 && (
      <div class="marquee" data-marquee data-count={set.length}>
        <div class="marquee__track">
          <ul class="marquee__set" role="list" aria-label={t('refs.brands', lang)}>
            {set.map((l, k) => (
              <li class="marquee__logo" aria-hidden={k >= logos.length ? 'true' : undefined}>
                <Image src={l.image} alt={k < logos.length ? l.name : ''} loading="lazy" />
              </li>
            ))}
          </ul>
          <ul class="marquee__set" role="list" aria-hidden="true">
            {set.map((l) => (
              <li class="marquee__logo">
                <Image src={l.image} alt="" loading="lazy" />
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {items.length > 0 && (
      <div class="refs__cases">
        {items.map((c) => (
          <article class="rcase">
            <div class="rcase__img media" data-position={c.position || undefined}>
              <Image
                src={c.image}
                alt={c.alt ?? ''}
                widths={[400, 720, 1256]}
                sizes="(min-width: 1024px) 44vw, 100vw"
                loading="lazy"
              />
            </div>
            {c.meta && <p class="eyebrow eyebrow--muted">{c.meta}</p>}
            <h3 class="rcase__title">{c.title}</h3>
            {c.results.length > 0 && (
              <dl class="rcase__results">
                {c.results.map((r) => (
                  <div>
                    <dt class="text-s text-2">{r.label}</dt>
                    <dd class="title">{r.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<script>
  // Тривалість стрічки — ~4 с на логотип (CSS-змінна зі скрипта: inline-стилі заборонені CSP).
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((el) => {
    el.style.setProperty('--marquee-duration', `${Number(el.dataset.count || 10) * 4}s`);
  });
  // Кадр фото кейса з даних (напр. «50% 22%») — через CSS-змінну (inline-стилі заборонені CSP).
  document.querySelectorAll<HTMLElement>('.rcase__img[data-position]').forEach((el) => {
    el.style.setProperty('--position', el.dataset.position ?? '');
  });
</script>

<style>
  .refs__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  /* ---------- Стрічка логотипів ---------- */
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee var(--marquee-duration, 72s) linear infinite;
  }
  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  /* Обидва набори однакові, з проміжком і в кінці — стик без стрибка. */
  .marquee__set {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    height: 3.5rem; /* 56 */
    padding-right: var(--space-10);
  }
  .marquee__logo {
    flex: none;
    display: flex;
    align-items: center;
  }
  .marquee__logo :global(img) {
    width: auto;
    height: 1.5rem; /* 24 */
    max-width: 9rem;
    object-fit: contain;
    filter: grayscale(1) brightness(1.6);
    opacity: 0.6;
    transition: opacity var(--dur) var(--ease);
  }
  @media (hover: hover) {
    .marquee__logo:hover :global(img) {
      opacity: 1;
    }
  }
  /* Зменшений рух: без руху, один ряд по центру з переносом. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }
    .marquee__track {
      width: auto;
      animation: none;
    }
    .marquee__set {
      flex-wrap: wrap;
      justify-content: center;
      height: auto;
      row-gap: var(--space-6);
      padding-right: 0;
    }
    .marquee__set[aria-hidden='true'],
    .marquee__logo[aria-hidden='true'] {
      display: none;
    }
  }
  .refs__cases {
    display: grid;
    gap: var(--space-8);
  }
  .rcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .rcase__img {
    aspect-ratio: 628 / 464; /* mobile 358 × 264 — та сама пропорція */
    border-radius: var(--radius-card);
  }
  .rcase__img :global(img) {
    object-position: var(--position, 50% 50%);
  }
  .rcase__title {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  .rcase__results {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
  }
  .rcase__results div {
    display: flex;
    flex-direction: column-reverse;
  }
  @media (min-width: 1024px) {
    .refs__inner {
      gap: var(--space-14);
    }
    .marquee__set {
      gap: var(--space-16);
      height: 5rem; /* 80 */
      padding-right: var(--space-16);
    }
    .marquee__logo :global(img) {
      height: 2rem; /* 32 */
    }
    .refs__cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
