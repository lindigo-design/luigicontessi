---
// Figma: Home → 07 Privilèges (desktop 4:91, mobile 6:339), Card / Code partenaire.
// Позначка «Partenariat» обовʼязкова (закон про інфлюенсерів 2023).
import Button from '../../ui/Button.astro';
import CodeCard from '../../ui/CodeCard.astro';
import type { Locale } from '../../../i18n/utils';
import type { HomeData } from '../../../content.config';

interface Props {
  lang: Locale;
  data: HomeData['privileges'];
  href: string;
}
const { lang, data, href } = Astro.props;
---

<section class="priv section" aria-labelledby="priv-title">
  <div class="container priv__inner">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">{data.eyebrow}</p>
        <h2 id="priv-title">{data.title}</h2>
        <p class="section-head__body">{data.body}</p>
      </div>
      <Button href={href} variant="accent">
        {data.link.label}
      </Button>
    </div>
    <ul class="priv__cards" role="list">
      {data.codes.map((c) => (
        <li>
          <CodeCard
            lang={lang}
            offer={c.offer}
            code={c.code}
            disclosure={c.disclosure}
            brandLabel={c.brandLink}
            brandUrl={c.brandUrl}
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .priv__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .priv__cards {
    display: grid;
    gap: var(--space-4);
  }
  /* На головній картка без логотипа і з відступом 28 на всіх ширинах (як у Figma Home). */
  .priv__cards :global(.ccard) {
    gap: var(--space-5);
    padding: var(--space-7);
  }
  @media (min-width: 1024px) {
    .priv__inner {
      gap: var(--space-16);
    }
    .priv__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
