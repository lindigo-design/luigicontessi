---
// Figma: Card / Yacht (Yachts → 03, Fiche yacht → 10 Autres yachts). Фото 10 : 7 (зум при наведенні) →
// назва → Longueur / Année / Cabines → «Prix sur demande» + «Voir le yacht». Уся картка — одне посилання
// (розтягнуте ::after), без вкладених посилань.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ArrowCircle from '../../ui/ArrowCircle.astro';
import { yachtHref, yachtPrice, yachtSpecs } from '../../../content/helpers';
import { t, type Locale } from '../../../i18n/utils';

interface Props {
  lang: Locale;
  yacht: {
    slug: string;
    name: string;
    length: number;
    year: number | null;
    cabins: number | null;
    price: number | null;
    image: ImageMetadata;
    imageAlt: Record<Locale, string>;
    demo: boolean;
  };
  /** Плашка «Illustration» (демо). */
  demoLabel?: string;
  /** Для фільтра за довжиною (Yachts): lt30 / 30-50 / gt50. */
  size?: string;
  class?: string;
}
const { lang, yacht: y, demoLabel, size, class: extra } = Astro.props;
---

<li class:list={['ycard zoom-card', extra]} data-yacht={size}>
  <div class="ycard__img media">
    <Image
      src={y.image}
      alt={y.imageAlt[lang]}
      widths={[400, 600, 800, 1200]}
      sizes="(min-width: 1024px) 31vw, (min-width: 768px) 48vw, 100vw"
      loading="lazy"
    />
    {y.demo && demoLabel && <p class="ycard__demo text-s">{demoLabel}</p>}
  </div>
  <h3 class="ycard__name">
    <a class="ycard__link" href={yachtHref(y.slug, lang)}>
      {y.name}
    </a>
  </h3>
  <dl class="ycard__specs">
    {yachtSpecs(y, lang).map((s) => (
      <div>
        <dt class="eyebrow eyebrow--muted">{s.label}</dt>
        <dd class="title">{s.value}</dd>
      </div>
    ))}
  </dl>
  <div class="ycard__bottom">
    <span class="text-s text-2">{yachtPrice(y, lang, t('yachts.priceOnRequest', lang))}</span>
    <span class="ycard__cta" aria-hidden="true">
      {t('yachts.see', lang)}
      <ArrowCircle />
    </span>
  </div>
</li>

<style>
  .ycard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .ycard[hidden] {
    display: none;
  }
  .ycard__img {
    position: relative;
    aspect-ratio: 10 / 7;
    border-radius: var(--radius-card);
  }
  .ycard__demo {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 1;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-btn);
    background: rgb(var(--shade) / 0.6);
  }
  .ycard__name {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  /* Уся картка — одне посилання (розтягнуте ::after). */
  .ycard__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .ycard__link:focus-visible {
    outline: none;
  }
  .ycard:has(.ycard__link:focus-visible) {
    outline: 2px solid var(--color-red-text);
    outline-offset: 4px;
    border-radius: var(--radius-card);
  }
  .ycard__specs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    padding-block: 0.875rem; /* 14 */
    border-block: 1px solid var(--color-border);
  }
  .ycard__specs div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .ycard__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  /* «Voir le yacht» — вигляд Link Accent (саме посилання — уся картка). */
  .ycard__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 2.75rem;
    font-weight: 600;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-red-text);
  }
  @media (hover: hover) {
    .ycard:hover .ycard__cta :global(.arrow) {
      background: var(--color-red-text);
      color: var(--color-bg);
    }
  }
  .ycard:has(.ycard__link:focus-visible) .ycard__cta :global(.arrow) {
    background: var(--color-red-text);
    color: var(--color-bg);
  }
</style>
