---
// Figma: Fiche yacht → 06 Plan de pont (desktop 38:602, mobile 39:638). Фон --color-bg-alt.
// «Trois ponts, pièce par pièce» (число — з кількості палуб). План (SVG як <img>, CSP) на всю ширину
// контейнера в картці --color-card; на mobile дрібний план гортається вбік. Під планом чипи палуб —
// перемикають план без перезавантаження (плавно, 200 ms). Одна палуба — без чипів. Демо без плану — заглушка.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { t, type Locale } from '../../../i18n/utils';

interface Props {
  lang: Locale;
  name: string;
  decks: { id: string; label: string; plan?: ImageMetadata }[];
  demoLabel?: string;
}
const { lang, name, decks, demoLabel } = Astro.props;
const words = ['', 'one', 'two', 'three', 'four', 'five'] as const;
const count = t(
  `yachts.decks.${words[Math.min(decks.length, 5)]}` as Parameters<typeof t>[0],
  lang,
);
const title = t('yachts.decksTitle', lang).replace('{count}', count);
---

<section class="ydeck section section--alt" aria-labelledby="ydeck-title" data-yacht-decks>
  <div class="container ydeck__inner">
    <div class="section-head__text">
      <p class="eyebrow">{t('yachts.decksEyebrow', lang)}</p>
      <h2 id="ydeck-title">{title}</h2>
    </div>
    <div class="ydeck__box">
      <div class="ydeck__frame">
        {decks.map((d, i) => (
          <div
            class:list={['ydeck__plan', { 'ydeck__plan--empty': !d.plan }]}
            data-deck-plan={d.id}
            hidden={i !== 0}
          >
            {d.plan ? (
              <Image src={d.plan} alt={`${name} — ${d.label}`} class="ydeck__img" />
            ) : (
              <span class="eyebrow eyebrow--muted">{d.label}</span>
            )}
          </div>
        ))}
        {demoLabel && <span class="ydeck__demo text-s">{demoLabel}</span>}
      </div>
      {decks.length > 1 && (
        <fieldset class="ydeck__chips">
          <legend class="visually-hidden">{t('yachts.decksEyebrow', lang)}</legend>
          <div class="ydeck__list">
            {decks.map((d, i) => (
              <label class="ydeck__chip">
                <input
                  class="visually-hidden"
                  type="radio"
                  name="deck"
                  value={d.id}
                  checked={i === 0}
                  data-deck-chip
                />
                <span class="chip">{d.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      )}
    </div>
  </div>
</section>

<script>
  // Перемикання палуб: показуємо вибраний план, плавно (opacity 200 ms; зменшений рух — одразу).
  document.querySelectorAll<HTMLElement>('[data-yacht-decks]').forEach((root) => {
    const plans = [...root.querySelectorAll<HTMLElement>('[data-deck-plan]')];
    root.querySelectorAll<HTMLInputElement>('[data-deck-chip]').forEach((chip) =>
      chip.addEventListener('change', () => {
        plans.forEach((p) => {
          const on = p.dataset.deckPlan === chip.value;
          p.hidden = !on;
          if (on) {
            p.classList.remove('is-in');
            requestAnimationFrame(() => p.classList.add('is-in'));
          }
        });
      }),
    );
  });
</script>

<style>
  .ydeck__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .ydeck__box {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  /* Mobile: план 358 × 240; дрібний — гортається вбік. */
  .ydeck__frame {
    position: relative;
    overflow-x: auto;
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .ydeck__plan {
    display: grid;
    place-items: center;
    min-width: 40rem; /* план не стискається дрібніше — гортаємо */
    aspect-ratio: 1280 / 400;
    min-height: 15rem; /* 240 */
  }
  /* Заглушка (демо без плану): на всю ширину картки, без прокрутки. */
  .ydeck__plan--empty {
    min-width: 0;
    aspect-ratio: auto;
    height: 15rem; /* 240 */
  }
  .ydeck__plan[hidden] {
    display: none;
  }
  .ydeck__plan.is-in {
    animation: ydeck-in 200ms var(--ease);
  }
  @keyframes ydeck-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ydeck__plan.is-in {
      animation: none;
    }
  }
  .ydeck__plan :global(.ydeck__img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .ydeck__demo {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-btn);
    background: rgb(var(--shade) / 0.6);
  }
  /* Чипи: mobile — горизонтальна прокрутка. */
  .ydeck__chips {
    min-width: 0;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0;
    border: 0;
  }
  .ydeck__list {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
    padding-inline: var(--gutter);
  }
  .ydeck__list::-webkit-scrollbar {
    display: none;
  }
  .ydeck__chip {
    flex: none;
    cursor: pointer;
  }
  .ydeck__chip input:checked + :global(.chip) {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-on-light);
  }
  .ydeck__chip input:focus-visible + :global(.chip) {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }
  @media (min-width: 1024px) {
    .ydeck__inner {
      gap: var(--space-10);
    }
    .ydeck__frame {
      overflow: hidden;
    }
    .ydeck__plan,
    .ydeck__plan--empty {
      min-width: 0;
      height: auto;
      aspect-ratio: 1280 / 400;
    }
    .ydeck__chips {
      margin: 0;
    }
    .ydeck__list {
      padding: 0;
      overflow: visible;
    }
  }
</style>
