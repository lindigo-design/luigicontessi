---
// Figma: À propos → 03 Le roi de cœur (desktop 50:433, mobile 50:568). Фон bg, без панелі.
// Desktop: два стовпці (проміжок 40, по центру висоти): ліворуч монограма K♥ (висота 256) по центру над текстом
// (на всю ширину стовпця 612: eyebrow → H2 → Body L, проміжок 20; уся група — проміжок 12), праворуч фото 628 × 459 (радіус 4).
// Mobile: монограма 145 зліва → текст (проміжок 14) → фото на всю ширину, проміжок 24.
// Текст — лише від Luigi (на сторінці: немає — у перегляді заглушка, на живому секції немає).
// Коли картка зʼявляється на екрані, монограма промальовується як у loader-і (window.lcMonogram з
// public/scripts/loader.js). Без JS і зі зменшеним рухом — готовий логотип.
import { Image } from 'astro:assets';
import CornerK from '../../../assets/brand/corner-k-tall.svg';
import photo from '../../../assets/img/about/symbole.jpg';

interface Props {
  data: { eyebrow: string; title: string; text: string; imageAlt?: string };
}
const { data } = Astro.props;
---

<section class="king section" aria-labelledby="king-title">
  <div class="container king__row">
    <div class="king__main">
      <div class="king__card" aria-hidden="true">
        <CornerK class="king__mark" data-monogram />
      </div>
      <div class="king__text">
        <p class="eyebrow">{data.eyebrow}</p>
        <h2 id="king-title">{data.title}</h2>
        {data.text.split(/\n{2,}/).map((p) => (
          <p class="king__body">{p}</p>
        ))}
      </div>
    </div>
    <div class="king__photo media">
      <Image
        src={photo}
        alt={data.imageAlt ?? ''}
        widths={[400, 720, 1200]}
        sizes="(min-width: 1024px) 44vw, 100vw"
        loading="lazy"
      />
    </div>
  </div>
</section>

<script>
  declare global {
    interface Window {
      lcMonogram?: (svg: SVGSVGElement) => void;
    }
  }
  // Промальовка — коли картка на екрані; функція з loader.js (async-скрипт — може зʼявитися трохи пізніше).
  const whenReady = (run: () => void) => {
    if (window.lcMonogram) return run();
    document
      .querySelector('script[src$="scripts/loader.js"]')
      ?.addEventListener('load', run, { once: true });
  };
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('[data-monogram]').forEach((svg) => {
      svg.classList.add('is-pending'); // сховати до промальовки (без JS — готовий логотип)
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          whenReady(() => {
            window.lcMonogram?.(svg);
            svg.classList.remove('is-pending');
          });
        },
        { threshold: 0.5 },
      );
      io.observe(svg);
    });
  }
</script>

<style>
  .king__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-6); /* 24 */
  }
  .king__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .king__card {
    display: flex;
  }
  .king__card :global(.king__mark) {
    width: auto;
    height: 9.0625rem; /* 145 */
    color: var(--color-red);
  }
  .king__card :global(.king__mark path) {
    fill: currentColor;
  }
  .king__card :global(.king__mark.is-pending path) {
    fill-opacity: 0;
  }
  .king__text {
    display: flex;
    flex-direction: column;
    gap: 0.875rem; /* 14 */
  }
  .king__body {
    font-size: var(--fs-body-l);
    color: var(--color-text-2);
  }
  .king__photo {
    aspect-ratio: 628 / 459;
    border-radius: var(--radius-card);
  }
  .king__photo :global(img) {
    object-position: 50% 69%; /* кадр з Figma: обличчя й крило Ferrari */
  }
  @media (min-width: 1024px) {
    .king__row {
      flex-direction: row;
      align-items: center;
      gap: var(--space-10); /* 40 */
    }
    .king__main {
      flex: 1 1 0;
      min-width: 0;
      gap: var(--space-3); /* 12 */
    }
    /* Монограма — по центру над текстом (у Figma — рамка 492 по центру). */
    .king__card {
      justify-content: center;
      width: min(100%, 30.75rem); /* 492 */
    }
    .king__card :global(.king__mark) {
      height: 16rem; /* 256 */
    }
    .king__text {
      width: 100%; /* 612 — на всю ширину стовпця */
      gap: var(--space-5); /* 20 */
    }
    .king__photo {
      flex: 0 1 39.25rem; /* 628 */
    }
  }
</style>
