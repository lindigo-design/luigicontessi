---
// Figma: Home → 02 À propos (desktop 3:49, mobile 6:221).
import { Image } from 'astro:assets';
import Button from '../../ui/Button.astro';
import portrait from '../../../assets/img/home/about.jpg';
import type { HomeData } from '../../../content.config';

interface Props {
  data: HomeData['about'];
  href: string;
}
const { data, href } = Astro.props;
---

<section class="about section" aria-labelledby="about-title">
  <div class="container about__row">
    <div class="about__img media">
      <Image
        src={portrait}
        alt={data.image.alt}
        widths={[400, 720, 1040]}
        sizes="(min-width: 1024px) 520px, 100vw"
      />
    </div>
    <div class="about__content">
      <div class="about__head">
        <div class="section-head__text">
          <p class="eyebrow">{data.eyebrow}</p>
          <h2 id="about-title">{data.title}</h2>
          <p class="text-2">{data.body}</p>
        </div>
        <Button href={href} variant="accent">
          {data.link.label}
        </Button>
      </div>
      <dl class="about__stats">
        {data.stats.map((s) => (
          <div class="stat">
            <dt class="text-s text-2">{s.label}</dt>
            <dd class="stat__value">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .about__img {
    aspect-ratio: 358 / 420;
  }
  .about__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .about__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .about__head p {
    max-width: 35rem;
  }
  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
  }
  .stat__value {
    font-family: var(--font-display);
    font-size: var(--fs-stat);
    line-height: 1.125;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  @media (min-width: 1024px) {
    .about__row {
      flex-direction: row;
      align-items: center;
      gap: var(--space-24);
    }
    .about__img {
      flex: 0 0 min(36%, 32.5rem);
      aspect-ratio: 520 / 640;
    }
    .about__stats {
      display: flex;
      gap: var(--space-14);
    }
  }
</style>
