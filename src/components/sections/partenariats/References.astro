---
// Figma: Partenariats → 05 Références (desktop 47:524). Логотипи марок (сітка 6 × 2, mobile 3 × 2,
// світлі монохромні, hover — яскравіші) і до 2 кейсів. Порожньо — блок схований;
// і логотипів, і кейсів немає — вся секція схована (рішення — на сторінці).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PartenariatsData } from '../../../content.config';

interface Props {
  data: PartenariatsData['references'];
  logos: { name: string; image: ImageMetadata }[];
  cases: {
    brand: string;
    type: string;
    title: string;
    image: ImageMetadata;
    alt: string;
    results: { value: string; label: string }[];
  }[];
}
const { data, logos, cases } = Astro.props;
---

<section class="refs section" aria-labelledby="refs-title">
  <div class="container refs__inner">
    <div class="section-head__text">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2 id="refs-title">{data.title}</h2>
    </div>

    {logos.length > 0 && (
      <ul class="refs__logos" role="list">
        {logos.map((l) => (
          <li class="refs__logo">
            <Image src={l.image} alt={l.name} widths={[200, 400]} sizes="200px" loading="lazy" />
          </li>
        ))}
      </ul>
    )}

    {cases.length > 0 && (
      <div class="refs__cases">
        {cases.map((c) => (
          <article class="rcase">
            <div class="rcase__img media">
              <Image
                src={c.image}
                alt={c.alt}
                widths={[400, 628, 1256]}
                sizes="(min-width: 1024px) 628px, 100vw"
                loading="lazy"
              />
            </div>
            <p class="eyebrow eyebrow--muted">
              {c.brand} · {c.type}
            </p>
            <h3 class="rcase__title">{c.title}</h3>
            {c.results.length > 0 && (
              <dl class="rcase__results">
                {c.results.map((r) => (
                  <div>
                    <dt class="text-s text-2">{r.label}</dt>
                    <dd class="title">{r.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .refs__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .refs__logos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .refs__logo {
    aspect-ratio: 200 / 80;
    padding: var(--space-3);
    overflow: hidden;
  }
  /* Логотипи світлі й монохромні; при наведенні — яскравіші. Вписуються в клітинку 200 × 80. */
  .refs__logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1) brightness(1.6);
    opacity: 0.6;
    transition: opacity var(--dur) var(--ease);
  }
  @media (hover: hover) {
    .refs__logo:hover :global(img) {
      opacity: 1;
    }
  }
  .refs__cases {
    display: grid;
    gap: var(--space-10);
  }
  .rcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .rcase__img {
    aspect-ratio: 628 / 380;
    border-radius: var(--radius-card);
  }
  .rcase__title {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  .rcase__results {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
  }
  .rcase__results div {
    display: flex;
    flex-direction: column-reverse;
  }
  @media (min-width: 1024px) {
    .refs__inner {
      gap: var(--space-14);
    }
    .refs__logos {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-4);
    }
    .refs__cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
