---
// Figma: Journal → 03 Articles. Фон bg/alt; сітка 3 колонки (56 × 40), 768–1023 — 2, mobile — 1.
// «Plus d'articles» (Outline, по центру; mobile — на всю ширину): спершу 6 карток, далі ще по 6
// (src/scripts/journal.ts). Без JS видно всі картки, кнопки немає.
import Button from '../../ui/Button.astro';
import ArticleCard from './ArticleCard.astro';
import { t, type Locale } from '../../../i18n/utils';
import type { Article } from './articleMeta';

interface Props {
  lang: Locale;
  articles: Article[];
}
const { lang, articles } = Astro.props;
---

<section class="jlist section--alt" aria-labelledby="jlist-title" data-journal-list>
  <div class="container jlist__inner">
    <h2 id="jlist-title" class="visually-hidden">
      {t('journal.list', lang)}
    </h2>
    {articles.length > 0 && (
      <ul class="jlist__grid" role="list">
        {articles.map((a) => (
          <ArticleCard lang={lang} article={a} />
        ))}
      </ul>
    )}
    <p class="jlist__empty text-2" data-journal-empty hidden>
      {t('journal.empty', lang)}
    </p>
    <div class="jlist__more" data-journal-more hidden>
      <Button variant="outline" class="jlist__btn">
        {t('journal.more', lang)}
      </Button>
    </div>
  </div>
</section>

<style>
  .jlist {
    padding-block: var(--space-14);
  }
  .jlist[hidden],
  .jlist__empty[hidden],
  .jlist__more[hidden] {
    display: none;
  }
  .jlist__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .jlist__grid {
    display: grid;
    gap: var(--space-10);
  }
  .jlist__more :global(.jlist__btn) {
    width: 100%;
  }
  @media (min-width: 768px) {
    .jlist__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-14) var(--space-10);
    }
    .jlist__more {
      display: flex;
      justify-content: center;
    }
    .jlist__more :global(.jlist__btn) {
      width: auto;
    }
  }
  @media (min-width: 1024px) {
    .jlist {
      padding-block: var(--space-24);
    }
    .jlist__inner {
      gap: var(--space-14);
    }
    .jlist__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
