---
// Figma: Home → 07 Privilèges (desktop 4:91, mobile 6:339), Card / Code partenaire.
// Позначка «Partenariat» обовʼязкова (закон про інфлюенсерів 2023).
import Button from '../../ui/Button.astro';
import { t, type Locale } from '../../../i18n/utils';
import type { HomeData } from '../../../content.config';

interface Props {
  lang: Locale;
  data: HomeData['privileges'];
  href: string;
}
const { lang, data, href } = Astro.props;
---

<section class="priv section" aria-labelledby="priv-title">
  <div class="container priv__inner">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">{data.eyebrow}</p>
        <h2 id="priv-title">{data.title}</h2>
        <p class="section-head__body">{data.body}</p>
      </div>
      <Button href={href} variant="accent">
        {data.link.label}
      </Button>
    </div>
    <ul class="priv__cards" role="list">
      {data.codes.map((c) => (
        <li class="code">
          <p class="code__top eyebrow eyebrow--muted">{c.disclosure}</p>
          <h3 class="code__offer">{c.offer}</h3>
          <div class="code__row">
            <span class="code__value">{c.code}</span>
            <Button data-copy={c.code} data-copied={t('ui.copied', lang)}>
              {t('ui.copyCode', lang)}
            </Button>
          </div>
          <Button href={c.brandUrl || href} variant="accent" external={!!c.brandUrl}>
            {c.brandLink}
          </Button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .priv__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .priv__cards {
    display: grid;
    gap: var(--space-4);
  }
  .code {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-7);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .code__top {
    align-self: flex-end;
  }
  .code__offer {
    min-height: 4.25rem; /* 68 px — однакова висота у всіх картках */
  }
  .code__row {
    display: flex;
    align-items: stretch;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-btn);
  }
  .code__value {
    flex: 1;
    display: flex;
    align-items: center;
    padding-inline: var(--space-5);
    font-weight: 600;
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
  }
  @media (min-width: 1024px) {
    .priv__inner {
      gap: var(--space-16);
    }
    .priv__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
