---
// Figma: 01 Hero → Header (desktop 1440 / mobile 390). Меню: Nav / Item, Nav / Logo, Nav / Menu button.
// На всю ширину. Лежить поверх першого екрана (прозорий фон); після прокрутки — суцільний фон
// і ховається при прокрутці вниз (src/scripts/header.ts).
import Logo from '../ui/Logo.astro';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import MenuIcon from '../../assets/icons/menu.svg';
import CloseIcon from '../../assets/icons/close.svg';
import { mainNav, utilityNav } from '../../i18n/nav';
import { localizePath, t, type Locale } from '../../i18n/utils';
import { getSettings } from '../../content/helpers';

interface Props {
  lang: Locale;
  current?: string;
}
const { lang, current } = Astro.props;
const settings = await getSettings();
const shop = settings.features.shop;
const items = mainNav.filter((i) => !i.shop || shop);
const to = (p: string) => localizePath(p, lang);
---

<header class="header" data-header>
  <div class="container container--bleed header__bar">
    <Logo href={to('')} label={t('nav.home', lang)} />

    <nav class="header__nav" aria-label={t('nav.main', lang)}>
      <ul role="list">
        {items.map((i) => (
          <li>
            <a
              class="nav-item"
              href={to(i.path)}
              aria-current={current === i.path ? 'page' : undefined}
            >
              {t(i.key, lang)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__utils">
      {utilityNav.map((i) => (
        <a
          class="nav-item"
          href={to(i.path)}
          aria-current={current === i.path ? 'page' : undefined}
        >
          {t(i.key, lang)}
        </a>
      ))}
      <LanguageSwitcher lang={lang} />
      {shop && (
        <a class="nav-item" href={to('panier')}>
          {t('nav.cart', lang)} (0)
        </a>
      )}
    </div>

    <button class="header__burger" type="button" data-menu-open aria-haspopup="dialog">
      <span class="visually-hidden">{t('nav.menu', lang)}</span>
      <MenuIcon />
    </button>
  </div>

  <dialog class="menu" data-menu aria-label={t('nav.main', lang)}>
    <div class="container container--bleed menu__inner">
      <div class="menu__top">
        <Logo href={to('')} label={t('nav.home', lang)} />
        <button class="header__burger menu__close" type="button" data-menu-close>
          <span class="visually-hidden">{t('nav.close', lang)}</span>
          <CloseIcon />
        </button>
      </div>
      <ul class="menu__list" role="list">
        {[...items, ...utilityNav].map((i) => (
          <li>
            <a href={to(i.path)} aria-current={current === i.path ? 'page' : undefined}>
              {t(i.key, lang)}
            </a>
          </li>
        ))}
      </ul>
      <LanguageSwitcher lang={lang} variant="footer" />
    </div>
  </dialog>
</header>

<script>
  // Меню-бургер на <dialog>: фокус усередині, Esc закриває.
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));

  import { initHeader } from '../../scripts/header';
  initHeader();
</script>

<style>
  /* sticky + мінус-відступ знизу: на першому екрані меню лежить поверх hero під промо-смугою,
     далі прилипає до верху. Висота незмінна (--header-pad + --header-h), тож нічого не стрибає. */
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    margin-bottom: calc(-1 * (var(--header-pad) + var(--header-h)) - 1px);
    padding-top: var(--header-pad);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      padding var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .header.is-solid {
    padding-block: calc(var(--header-pad) / 2);
    background: var(--color-bg);
    border-bottom-color: var(--color-border);
  }
  .header.is-hidden:not(:focus-within) {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .header {
      transition: none;
    }
  }
  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .header__nav,
  .header__utils {
    display: none;
  }
  .header__nav ul {
    display: flex;
    gap: var(--space-1);
  }
  .nav-item {
    display: inline-flex;
    align-items: center;
    min-height: var(--header-h);
    padding-inline: 0.625rem;
    font-weight: 500;
    font-size: var(--fs-label);
    line-height: 1.23;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text);
    transition: color var(--dur) var(--ease);
  }
  .nav-item:hover {
    color: var(--color-text-2);
  }
  .nav-item[aria-current='page'] {
    color: var(--color-red-text);
  }
  .header__burger {
    display: inline-grid;
    place-items: center;
    width: var(--header-h);
    height: var(--header-h);
    margin-right: -0.625rem;
  }
  @media (min-width: 1100px) {
    /* Логотип — ліворуч, меню — по центру екрана, Partenariats і мови — праворуч. */
    .header__bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .header__bar > :global(.logo) {
      justify-self: start;
    }
    .header__utils {
      justify-self: end;
    }
    .header__nav,
    .header__utils {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }
    .header__burger {
      display: none;
    }
  }

  /* Мобільне меню */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }
  .menu::backdrop {
    background: rgb(var(--shade) / 0.6);
  }
  .menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding-block: var(--space-5) var(--space-10);
  }
  .menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .menu__list {
    display: flex;
    flex-direction: column;
  }
  .menu__list a {
    display: block;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: 1.2;
  }
  .menu__list a[aria-current='page'] {
    color: var(--color-red-text);
  }
</style>
