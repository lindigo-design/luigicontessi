---
// Figma: Fiche yacht → 07 Le mot de Luigi (desktop 38:622, mobile 39:655). Фон --color-bg-alt.
// eyebrow → цитата (Desktop/Quote 36, mobile 24, макс. 980) → «— Luigi Contessi». Порожньо — секції немає
// (рішення на сторінці): жодного «[mois]» на сайті.
import { t, type Locale } from '../../../i18n/utils';

interface Props {
  lang: Locale;
  quote: string;
  /** Підпис — ім'я з settings.json (name). */
  author: string;
}
const { lang, quote, author } = Astro.props;
---

<section class="yword section section--alt" aria-labelledby="yword-title">
  <figure class="container yword__inner">
    <p class="eyebrow" id="yword-title">
      {t('yachts.luigiWord', lang)}
    </p>
    <blockquote class="yword__quote">
      <p>{`${t('ui.quoteOpen', lang)}${quote}${t('ui.quoteClose', lang)}`}</p>
    </blockquote>
    <figcaption class="eyebrow eyebrow--muted">— {author}</figcaption>
  </figure>
</section>

<style>
  .yword__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .yword__quote {
    max-width: 61.25rem; /* 980 */
    font-family: var(--font-display);
    font-size: var(--fs-quote);
    line-height: 1.28;
  }
  @media (min-width: 1024px) {
    .yword__inner {
      gap: var(--space-6);
    }
  }
</style>
