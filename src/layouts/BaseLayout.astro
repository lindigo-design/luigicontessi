---
// Каркас кожної сторінки: <head>, SEO, мови, header, footer.
import '../styles/global.css';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import CookieConsent from '../components/sections/CookieConsent.astro';
import Loader from '../components/ui/Loader.astro';
import { consentCategories } from '../content/helpers';
import { locales, localizePath, switchLocale, t, type Locale } from '../i18n/utils';
import { getSettings } from '../content/helpers';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  current?: string;
  noindex?: boolean;
  /** overlay — шапка поверх першого фото (головна, Article); solid — окрема смуга (усі інші). */
  header?: 'overlay' | 'solid';
  /** Loader K♥ для повільного інтернету (перше відкриття в сесії). 404 / 500 — false. */
  loader?: boolean;
}
const {
  lang,
  title,
  description,
  current,
  noindex = false,
  header = 'solid',
  loader = true,
} = Astro.props;
const settings = await getSettings();
const cookies = consentCategories(settings); // підключені сервіси, яким потрібна згода
const site = Astro.site ?? new URL('https://luigicontessi.com');
const canonical = new URL(Astro.url.pathname, site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = new URL(`${base}og-image.png`, site).href;
// Тестова копія (GitHub Pages) не має потрапляти в Google: PUBLIC_NOINDEX=true під час збірки.
const hideFromSearch = noindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const ogLocale = { fr: 'fr_FR', en: 'en_GB', it: 'it_IT' }[lang];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: settings.name,
  url: new URL(localizePath('', lang), site).href,
  sameAs: settings.socials.filter((s) => s.url).map((s) => s.url),
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(switchLocale(Astro.url.pathname, l), site).href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLocale(Astro.url.pathname, 'fr'), site).href}
    />
    {hideFromSearch && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0E0E0E" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    {loader && <Loader lang={lang} />}
    <a class="skip" href="#main">
      {t('skip', lang)}
    </a>
    <slot name="top" />
    <div class="page-top">
      <Header lang={lang} current={current} mode={header} />
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer lang={lang} current={current} />
    {cookies.length > 0 && <CookieConsent lang={lang} categories={cookies} />}
    <script>
      import { initCartCount } from '../scripts/cart';
      import { initCopy } from '../scripts/copy';
      import { initCountUp } from '../scripts/count-up';
      import { initHoverCards } from '../scripts/hover-card';
      import { initPlaceholderLinks } from '../scripts/placeholder-links';
      initCopy();
      initCartCount();
      initPlaceholderLinks();
      initCountUp();
      initHoverCards();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-3) var(--space-4);
    background: var(--color-text);
    color: var(--color-on-light);
  }
  .skip:focus {
    top: var(--space-4);
  }
  .page-top {
    position: relative;
  }
</style>
