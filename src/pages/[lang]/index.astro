---
// Головна сторінка. Тут лише порядок секцій (як у Figma) і куди ведуть кнопки.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromoBar from '../../components/sections/PromoBar.astro';
import Hero from '../../components/sections/home/Hero.astro';
import About from '../../components/sections/home/About.astro';
import Quote from '../../components/sections/home/Quote.astro';
import Press from '../../components/sections/home/Press.astro';
import News from '../../components/sections/home/News.astro';
import Universes from '../../components/sections/home/Universes.astro';
import Collection from '../../components/sections/home/Collection.astro';
import Privileges from '../../components/sections/home/Privileges.astro';
import Yachts from '../../components/sections/home/Yachts.astro';
import Instagram from '../../components/sections/home/Instagram.astro';
import Faq from '../../components/sections/home/Faq.astro';
import ForBrands from '../../components/sections/home/ForBrands.astro';
import {
  favoriteHref,
  getFavorites,
  getHome,
  getProducts,
  getSettings,
  getStats,
  productPath,
} from '../../content/helpers';
import { getCollection } from 'astro:content';
import { locales, localizePath, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const page = await getHome(lang);
const settings = await getSettings();
const to = (path: string) => localizePath(path, lang);
// Картки з полем product ведуть на сторінку товару; slug перевіряємо, щоб не було битих посилань.
const productSlugs = new Set((await getProducts()).map((p) => p.slug));
const productHref = (product: string | undefined, fallback: string) => {
  if (!product) return fallback;
  if (!productSlugs.has(product))
    throw new Error(`Головна: немає товару «${product}» (поле product)`);
  return productPath(product, lang);
}; // Coup de cœur (поле favorite): назва — з Coups de cœur (одне місце для даних); картка веде на сторінку
// товару (коли буде, favoriteHref) або на Coups de cœur з його рубрикою. Демо на живому сайті — без рубрики.
const allFavorites = new Map((await getCollection('favorites')).map((e) => [e.id, e.data]));
const shownFavorites = new Set((await getFavorites()).map((f) => f.slug));
const favoriteOf = (slug: string) => {
  const f = allFavorites.get(slug);
  if (!f) throw new Error(`Головна: немає Coup de cœur «${slug}» (поле favorite)`);
  return f;
};
const news = {
  ...page.news,
  items: page.news.items.map((item) =>
    item.favorite ? { ...item, name: favoriteOf(item.favorite).name[lang] } : item,
  ),
};
const newsHref = (item: (typeof news.items)[number]) => {
  if (!item.favorite) return productHref(item.product, to('coups-de-coeur'));
  const f = favoriteOf(item.favorite);
  return (
    favoriteHref(f.slug, lang) ??
    (shownFavorites.has(f.slug)
      ? `${to('coups-de-coeur')}?categorie=${f.category}`
      : to('coups-de-coeur'))
  );
};
---

<BaseLayout
  lang={lang}
  title={page.seoTitle}
  description={page.seoDescription}
  header="overlay"
  current=""
>
  <PromoBar slot="top" lang={lang} data={page.promo} />
  <Hero
    data={page.hero}
    primaryHref={to('journal')}
    secondaryHref={to('collection')}
    cardHref={to('coups-de-coeur')}
  />
  <About data={page.about} stats={await getStats(page.about.stats, lang)} href={to('a-propos')} />
  <Quote data={page.quote} />
  <Press data={page.press} href={to('presse')} />
  <News lang={lang} data={news} itemHref={newsHref} />
  <Universes data={page.universes} href={to('journal')} />
  <Collection
    data={page.collection}
    href={to('collection')}
    itemHref={(product) => productHref(product, to('collection'))}
  />
  <Privileges lang={lang} data={page.privileges} href={to('privileges')} />
  <Yachts data={page.yachts} listHref={to('yachts')} contactHref={to('contact')} />
  <Instagram
    lang={lang}
    data={page.instagram}
    handle={settings.instagramHandle}
    url={settings.instagramUrl}
  />
  <Faq data={page.faq} href={to('faq')} />
  <ForBrands
    lang={lang}
    data={page.brands}
    ctaHref={to('partenariats')}
    contactHref={to('contact')}
  />
</BaseLayout>
