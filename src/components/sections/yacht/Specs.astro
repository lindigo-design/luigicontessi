---
// Figma: Fiche yacht → 04 Caractéristiques (desktop 38:515, mobile 39:585). Фон --color-bg-alt.
// «Fiche technique»: сітка 4 колонки (mobile 2) — лише заповнені значення, без дірок.
// «Télécharger la fiche (PDF, 1,2 Mo)» — лише якщо є PDF (desktop — під сіткою, mobile — під заголовком).
import ArrowCircle from '../../ui/ArrowCircle.astro';
import { t, type Locale } from '../../../i18n/utils';

interface Props {
  lang: Locale;
  specs: { label: string; value: string }[];
  /** PDF: адреса і підпис розміру («PDF, 1,2 Mo») або null. */
  sheet: { href: string; size: string } | null;
}
const { lang, specs, sheet } = Astro.props;
---

<section class="yspecs section section--alt" aria-labelledby="yspecs-title">
  <div class="container yspecs__inner">
    <div class="section-head__text">
      <p class="eyebrow">{t('yachts.specsEyebrow', lang)}</p>
      <h2 id="yspecs-title">{t('yachts.specsTitle', lang)}</h2>
    </div>
    {sheet && (
      <a class="yspecs__pdf" href={sheet.href} download>
        <span>
          {t('yachts.downloadSheet', lang)} ({sheet.size})
        </span>
        <ArrowCircle />
      </a>
    )}
    <dl class="yspecs__grid">
      {specs.map((s) => (
        <div class="yspecs__cell">
          <dt class="eyebrow eyebrow--muted">{s.label}</dt>
          <dd class="title">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .yspecs__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .yspecs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-4);
  }
  .yspecs__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  /* Link Accent з колом-стрілкою (файл, а не перехід — тому <a download>, а не Button). */
  .yspecs__pdf {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    align-self: flex-start;
    min-height: 2.75rem;
    font-weight: 600;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-red-text);
  }
  @media (hover: hover) {
    .yspecs__pdf:hover :global(.arrow) {
      background: var(--color-red-text);
      color: var(--color-bg);
    }
  }
  @media (min-width: 768px) {
    .yspecs__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 var(--space-6);
    }
    .yspecs__cell {
      padding-block: var(--space-5);
    }
    .yspecs__pdf {
      order: 3; /* desktop — під сіткою */
      margin-top: var(--space-6);
    }
  }
  @media (min-width: 1024px) {
    .yspecs__inner {
      gap: var(--space-14);
    }
    .yspecs__pdf {
      margin-top: 0;
    }
  }
</style>
