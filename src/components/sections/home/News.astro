---
// Figma: Home → 04 Nouveautés (desktop 3:76, mobile 6:245).
// Карусель: активна картка більша й з описом, завжди по центру екрана. Трек — на всю ширину.
// Безкінечна: по краях — копії 2 останніх / 2 перших карток (лише візуальні), скрипт тихо
// перескакує з копії на справжню. Стрілки (desktop), свайп і крапки (mobile), клавіші ← → Home End.
// Висота не стрибає: текстовий блок фіксованої висоти, опис — рівно 2 рядки.
import { Image } from 'astro:assets';
import Button from '../../ui/Button.astro';
import ArrowCircle from '../../ui/ArrowCircle.astro';
import n1 from '../../../assets/img/home/news-1.jpg';
import n2 from '../../../assets/img/home/news-2.jpg';
import n3 from '../../../assets/img/home/news-3.jpg';
import n4 from '../../../assets/img/home/news-4.jpg';
import n5 from '../../../assets/img/home/news-5.jpg';
import veste from '../../../assets/img/products/veste-contessi/noir-1.jpg';
import { t, type Locale } from '../../../i18n/utils';
import type { HomeData } from '../../../content.config';

interface Props {
  lang: Locale;
  data: HomeData['news'];
  /** Куди веде картка: товар (Collection) → його сторінка, Coup de cœur → Coups de cœur з рубрикою. */
  itemHref: (item: HomeData['news']['items'][number]) => string;
}
const { lang, data, itemHref } = Astro.props;
// Порядок = порядок карток у home.json → news.items. 4-та — «Veste Contessi», веде на сторінку товару.
const images = [n1, n2, n3, veste, n4, n5];
// Вертикальні фото у великій картці: яку частину кадру показати. low — нижче (видно ноги й сумку).
const focus = new Map([
  [n1, 'low'],
  [n3, 'low'],
]);
const total = data.items.length;
const start = Math.floor(total / 2);
// Менше 3 карток — без зациклення і без стрілок.
const loop = total >= 3;
const CLONES = 2;
const real = data.items.map((item, i) => ({ item, i, clone: false }));
const slides = loop
  ? [
      ...real.slice(-CLONES).map((s) => ({ ...s, clone: true })),
      ...real,
      ...real.slice(0, CLONES).map((s) => ({ ...s, clone: true })),
    ]
  : real;
---

<section
  class:list={['news', 'section', 'section--alt', { 'news--static': !loop }]}
  aria-labelledby="news-title"
  data-carousel
  data-loop={loop ? '' : undefined}
>
  <div class="container news__head">
    <p class="eyebrow">
      <span class="eyebrow--muted">{data.index}</span> {data.eyebrow}
    </p>
    <h2 id="news-title">
      <span class="news__title-m">{data.titleMobile}</span>
      <span class="news__title-d">{data.title}</span>
    </h2>
  </div>

  <ul class="news__track" role="list" data-track>
    {slides.map(({ item, i, clone }) => (
      <li
        class:list={['ncard', 'zoom-card', { 'is-active': !clone && i === start }]}
        data-slide
        data-index={i}
        data-clone={clone ? '' : undefined}
        aria-hidden={clone ? 'true' : undefined}
        inert={clone}
        aria-label={clone ? undefined : `${t('ui.slide', lang)} ${i + 1} / ${total}`}
      >
        <a
          class:list={[
            'ncard__img',
            'media',
            focus.has(images[i]) && `ncard__img--${focus.get(images[i])}`,
          ]}
          href={itemHref(item)}
          tabindex="-1"
          aria-hidden="true"
        >
          <Image
            src={images[i]}
            alt=""
            widths={[320, 560, 1120]}
            sizes="(min-width: 1024px) min(39vw, 720px), 80vw"
          />
        </a>
        <div class="ncard__info">
          <p class="ncard__tag eyebrow eyebrow--muted">{item.tag}</p>
          <h3 class="ncard__name title" title={item.name}>
            {item.name}
          </h3>
          {item.description ? (
            <p class="ncard__desc text-s text-2">{item.description}</p>
          ) : (
            <p class="ncard__desc text-s" aria-hidden="true" />
          )}
          <Button href={itemHref(item)} variant="accent" tabindex={clone ? -1 : undefined}>
            {item.action}
            <span class="visually-hidden"> — {item.name}</span>
          </Button>
        </div>
      </li>
    ))}
  </ul>

  <div class="container news__controls">
    <button class="news__arrow" type="button" data-prev>
      <span class="visually-hidden">{t('ui.prev', lang)}</span>
      <ArrowCircle size="l" dir="prev" />
    </button>
    <ol class="news__dots" role="list">
      {data.items.map((_, i) => (
        <li>
          <button
            class:list={['news__dot', { 'is-active': i === start }]}
            type="button"
            aria-label={`${t('ui.slide', lang)} ${i + 1} / ${total}`}
            aria-current={i === start ? 'true' : undefined}
            data-dot
          />
        </li>
      ))}
    </ol>
    <button class="news__arrow" type="button" data-next>
      <span class="visually-hidden">{t('ui.next', lang)}</span>
      <ArrowCircle size="l" />
    </button>
  </div>
</section>

<script>
  import { initCarousels } from '../../../scripts/carousel';
  initCarousels();
</script>

<style>
  .news {
    /* Розміри карток ростуть разом з екраном: 240 → 280 (1440) → 360; активна 300 → 560 → 720. */
    --ncard-w: clamp(15rem, 19.5vw, 22.5rem);
    --ncard-w-active: clamp(18.75rem, 39vw, 45rem);
    --ncard-ratio: 420 / 300; /* висота / ширина фото активної картки */
    /* Текстовий блок фіксованої висоти: тег 16 + назва 26 + опис 40 + «Voir» 44 + 3 проміжки по 12. */
    --ncard-info-h: calc(1rem + 1.625rem + 2.5rem + 2.75rem + 3 * var(--space-3));
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .news__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .news__title-d {
    display: none;
  }
  /* Відступи треку = (ширина − активна картка) / 2: крайні картки теж стають по центру. */
  .news__track {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: 0;
    padding-inline: calc(50% - var(--ncard-w-active) / 2);
    /* Висоту задає активна картка (фото + текстовий блок) — під час переходу вона не «дихає». */
    min-height: calc(
      var(--ncard-w-active) * var(--ncard-ratio) + var(--space-3) + var(--ncard-info-h)
    );
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .news__track::-webkit-scrollbar {
    display: none;
  }
  .ncard {
    flex: 0 0 var(--ncard-w);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    scroll-snap-align: center;
    transition: flex-basis 500ms var(--ease);
  }
  .ncard__img {
    width: 100%;
    aspect-ratio: 300 / 420;
  }
  .ncard__img--low :global(img) {
    object-position: 50% 78%;
  }
  /* Тихий перескок з копії на справжню картку: без прилипання і без анімації ширини.
     is-moving — під час прокрутки стрілками/клавішами: інакше прилипання «доклеює» стрічку
     до проміжного положення, поки ширини карток ще анімуються. */
  .news__track.is-jumping,
  .news__track.is-moving {
    scroll-snap-type: none;
  }
  .news__track.is-jumping .ncard,
  .news__track.is-jumping .ncard__img {
    transition: none;
  }
  .ncard__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    width: 100%;
  }
  .ncard__tag,
  .ncard__name {
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .ncard__desc {
    display: none;
  }
  .ncard.is-active {
    flex-basis: var(--ncard-w-active);
  }
  /* Опис — рівно 2 рядки місця: коротший чи порожній не зсуває «Voir», довший обрізається. */
  .ncard.is-active .ncard__desc {
    display: -webkit-box;
    min-height: calc(2 * 1.43em);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-6);
  }
  .news__arrow {
    display: none;
  }
  .news__dots {
    display: flex;
    gap: var(--space-2);
  }
  /* Крапка 6 px, зона кліку 24 × 24. */
  .news__dot {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-inline: -9px;
  }
  .news__dot::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border);
    transition: background-color var(--dur) var(--ease);
  }
  .news__dot.is-active::before {
    background: var(--color-text);
  }
  .news.news--static .news__arrow {
    display: none;
  }

  @media (min-width: 1024px) {
    .news {
      gap: var(--space-12);
    }
    .news__head {
      flex-direction: row;
      gap: var(--space-10);
    }
    .news__head .eyebrow {
      flex: 0 0 25rem;
    }
    .news__title-m {
      display: none;
    }
    .news__title-d {
      display: inline;
    }
    .news {
      --ncard-ratio: 680 / 560;
    }
    .news__track {
      gap: var(--space-6);
    }
    .ncard__img {
      aspect-ratio: 1;
      transition: aspect-ratio 500ms var(--ease);
    }
    .ncard.is-active .ncard__img {
      aspect-ratio: 560 / 680;
    }
    .news__arrow {
      display: inline-flex;
      color: var(--color-text);
      pointer-events: auto;
    }
    .news__arrow:hover :global(.arrow) {
      background: var(--color-text);
      color: var(--color-bg);
    }
    .news__dots {
      display: none;
    }
    /* Стрілки — по боках від активної картки (± 24 px), на рівні її текстового блоку. */
    .news__controls {
      position: relative;
      z-index: 1;
      justify-content: space-between;
      max-width: calc(var(--ncard-w-active) + 2 * (5.5rem + var(--space-6)));
      /* gap секції + половина (текстовий блок + стрілка) → центр стрілки = центр текстового блоку */
      margin-top: calc(-1 * (var(--space-12) + (var(--ncard-info-h) + 5.5rem) / 2));
      padding-inline: 0;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ncard,
    .ncard__img {
      transition: none;
    }
  }
</style>
