---
// Figma: Partenariats → 06 Presse (desktop 47:590). Ліворуч «Dans la presse» — ті самі статті, що
// «Presse» на головній (перші 3, без заглушок «[…]»); праворуч картка Media kit (id="media-kit",
// туди веде «Media kit» у футері). Статей немає — лише картка. Mobile: спершу статті, потім картка.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../../ui/Button.astro';
import type { HomeData, PartenariatsData } from '../../../content.config';

interface Props {
  press: PartenariatsData['press'];
  articles: HomeData['press']['items'];
  articlesHref: string;
  kit: PartenariatsData['mediaKit'];
  kitTitle: string;
  kitText: string;
  /** PDF або null — тоді «Demander le media kit» → #proposer. */
  kitUrl: string | null;
  requestLabel: string;
  preview?: ImageMetadata;
}
const { press, articles, articlesHref, kit, kitTitle, kitText, kitUrl, requestLabel, preview } =
  Astro.props;
---

<section
  class:list={['presskit section', { 'presskit--solo': !articles.length }]}
  aria-labelledby={articles.length ? 'presskit-title' : 'media-kit-title'}
>
  <div class="container presskit__row">
    {articles.length > 0 && (
      <div class="presskit__press">
        <div class="section-head__text">
          <p class="eyebrow">{press.eyebrow}</p>
          <h2 id="presskit-title">{press.title}</h2>
        </div>
        <ul class="presskit__list" role="list">
          {articles.map((a) => (
            <li class="particle">
              <div class="particle__text">
                <p class="title">{a.title}</p>
                <p class="text-s text-2">{a.meta}</p>
              </div>
              <Button href={articlesHref} variant="accent">
                {a.action}
              </Button>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="kit" id="media-kit">
      {preview && (
        <div class="kit__preview media">
          <Image
            src={preview}
            alt={kit.previewAlt}
            widths={[360, 720]}
            sizes="360px"
            loading="lazy"
          />
        </div>
      )}
      <h2 id="media-kit-title" class="kit__title">
        {kitTitle}
      </h2>
      <p class="text-s text-2">{kitText}</p>
      {kitUrl ? (
        <Button href={kitUrl} block download>
          {kit.download.label}
        </Button>
      ) : (
        <Button href="#proposer" block>
          {requestLabel}
        </Button>
      )}
    </div>
  </div>
</section>

<style>
  .presskit__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .presskit__press {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .particle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .particle__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }
  .kit {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-card);
    scroll-margin-top: calc(var(--header-total-h) + var(--space-6));
  }
  .kit__preview {
    aspect-ratio: 360 / 240;
    border-radius: var(--radius-card);
  }
  .kit__title {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  @media (min-width: 1024px) {
    .presskit__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 27.5rem; /* 440 */
      align-items: start;
      gap: var(--space-20);
    }
    .presskit--solo .presskit__row {
      grid-template-columns: 27.5rem;
    }
    .kit {
      padding: var(--space-10);
    }
  }
</style>
