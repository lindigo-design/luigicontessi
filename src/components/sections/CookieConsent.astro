---
// Figma: Cookies → банер desktop 55:416, mobile 55:430, вікно «Paramètres cookies» 55:443.
// Показується лише коли в settings.json → consent хоч одна категорія true (див. BaseLayout).
// Банер прихований, доки src/scripts/consent.ts не перевірить збережений вибір (без JS — немає
// і необовʼязкових cookies). «Tout refuser» і «Tout accepter» — однакові Outline (CNIL).
import Button from '../ui/Button.astro';
import CloseIcon from '../../assets/icons/close.svg';
import type { ConsentCategory } from '../../scripts/consent';
import { t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
  categories: ConsentCategory[];
}
const { lang, categories } = Astro.props;
const rows: { id: 'necessary' | ConsentCategory; on: boolean }[] = [
  { id: 'necessary', on: true },
  ...categories.map((id) => ({ id, on: false })),
];
---

<div
  class="cbanner"
  role="region"
  aria-label={t('cookies.title', lang)}
  data-consent-banner
  data-consent-categories={categories.join(' ')}
  hidden
>
  <div class="cbanner__wrap">
    <div class="cbanner__card">
      <div class="cbanner__text">
        <p class="title">{t('cookies.title', lang)}</p>
        <p class="text-s text-2">
          <span class="cbanner__long">{t('cookies.text', lang)}</span>
          <span class="cbanner__short">{t('cookies.textShort', lang)}</span>
        </p>
      </div>
      <div class="cbanner__actions">
        <Button variant="link" arrow class="cbanner__custom" data-consent-open="">
          {t('cookies.customise', lang)}
        </Button>
        <Button variant="outline" data-consent-action="refuse">
          {t('cookies.refuse', lang)}
        </Button>
        <Button variant="outline" data-consent-action="accept">
          {t('cookies.accept', lang)}
        </Button>
      </div>
    </div>
  </div>
</div>

<dialog class="cdlg" data-consent-dialog aria-labelledby="cdlg-title">
  <div class="cdlg__head">
    <h2 id="cdlg-title" class="cdlg__title" tabindex="-1" data-consent-title>
      {t('cookies.settings', lang)}
    </h2>
    <button class="cdlg__close" type="button" data-consent-action="close">
      <span class="visually-hidden">{t('nav.close', lang)}</span>
      <CloseIcon />
    </button>
  </div>
  <ul class="cdlg__rows" role="list">
    {rows.map((r) => (
      <li class="crow">
        <div class="crow__text">
          <p class="title" id={`crow-${r.id}`}>
            {t(`cookies.${r.id}`, lang)}
          </p>
          <p class="text-s text-2" id={`crow-${r.id}-text`}>
            {t(`cookies.${r.id}Text`, lang)}
          </p>
        </div>
        {r.on ? (
          <input
            class="switch"
            type="checkbox"
            role="switch"
            checked
            disabled
            aria-checked="true"
            aria-labelledby={`crow-${r.id}`}
            aria-describedby={`crow-${r.id}-text`}
          />
        ) : (
          <input
            class="switch"
            type="checkbox"
            role="switch"
            data-consent-switch={r.id}
            aria-labelledby={`crow-${r.id}`}
            aria-describedby={`crow-${r.id}-text`}
          />
        )}
      </li>
    ))}
  </ul>
  <div class="cdlg__actions">
    <Button variant="outline" data-consent-action="refuse">
      {t('cookies.refuse', lang)}
    </Button>
    <Button variant="outline" data-consent-action="accept">
      {t('cookies.accept', lang)}
    </Button>
    <Button data-consent-action="save">{t('cookies.save', lang)}</Button>
  </div>
</dialog>

<script>
  import { initConsent } from '../../scripts/consent';
  initConsent();
</script>

<style>
  /* Поки банер видимий, низ сторінки (футер) не ховається під ним. */
  :global(html.has-consent-banner body) {
    padding-bottom: var(--consent-h);
  }

  /* ---------- Банер: mobile — аркуш знизу на всю ширину ---------- */
  .cbanner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 20; /* над контентом і шапкою; меню й вікна — <dialog> у верхньому шарі */
    transform: translateY(100%);
    opacity: 0;
    transition:
      transform var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }
  .cbanner[hidden] {
    display: none;
  }
  .cbanner.is-visible {
    transform: none;
    opacity: 1;
  }
  .cbanner__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4) calc(var(--space-8) + env(safe-area-inset-bottom));
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--color-card);
    box-shadow: inset 0 1px 0 var(--color-border);
  }
  .cbanner__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cbanner__long {
    display: none;
  }
  /* Mobile: Tout refuser · Tout accepter — 50/50, під ними Personnaliser. */
  .cbanner__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .cbanner__actions :global(.btn--outline) {
    padding-inline: var(--space-3);
  }
  .cbanner__actions :global(.cbanner__custom) {
    grid-row: 2;
    grid-column: 1 / -1;
    justify-self: start;
  }

  /* ---------- Вікно «Paramètres cookies»: mobile — аркуш знизу ---------- */
  .cdlg {
    width: 100%;
    max-width: 100%;
    max-height: 90svh;
    margin: auto 0 0;
    padding: var(--space-6) var(--space-4) calc(var(--space-6) + env(safe-area-inset-bottom));
    overflow-y: auto;
    border: 0;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--color-card);
    color: var(--color-text);
  }
  .cdlg[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .cdlg::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .cdlg__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .cdlg__title {
    font-size: var(--fs-h3);
    outline: none;
  }
  .cdlg__close {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--header-h); /* зона кліку 44 × 44, хрестик 24 */
    height: var(--header-h);
    margin-right: -0.625rem;
  }
  .cdlg__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .crow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .crow__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* Перемикач 44 × 24: увімкнений — світлий фон, кружок справа; вимкнений — сірий, кружок зліва. */
  .switch {
    appearance: none;
    position: relative;
    flex: none;
    width: 2.75rem;
    height: 1.5rem;
    margin: 0;
    border-radius: 0.75rem;
    background: var(--color-border);
    cursor: pointer;
    transition: background-color 150ms var(--ease);
  }
  .switch::before {
    content: '';
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--color-text-2);
    transition:
      transform 150ms var(--ease),
      background-color 150ms var(--ease);
  }
  .switch:checked {
    background: var(--color-text);
  }
  .switch:checked::before {
    transform: translateX(1.25rem);
    background: var(--color-bg);
  }
  .switch:disabled {
    cursor: default;
    opacity: 0.55;
  }
  .switch:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  /* Mobile: кнопки стовпчиком на всю ширину, Enregistrer зверху. */
  .cdlg__actions {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-3);
    padding-top: var(--space-1);
  }

  @media (min-width: 768px) {
    /* Банер — плашка над низом сторінки, по ширині контейнера. */
    .cbanner {
      bottom: var(--space-8);
      transform: translateY(calc(100% + var(--space-8)));
    }
    .cbanner__wrap {
      max-width: calc(var(--content-max) + 2 * var(--gutter));
      margin-inline: auto;
      padding-inline: var(--gutter);
    }
    .cbanner__card {
      padding: var(--space-8);
      border-radius: var(--radius-card);
      box-shadow: inset 0 0 0 1px var(--color-border);
    }
    .cbanner__long {
      display: inline;
    }
    .cbanner__short {
      display: none;
    }
    .cbanner__actions {
      display: flex;
      align-items: center;
    }
    .cbanner__actions :global(.btn--outline) {
      padding-inline: var(--space-7);
    }
    .cbanner__actions :global(.cbanner__custom) {
      margin-right: var(--space-3);
    }

    .cdlg {
      width: min(100% - 2 * var(--gutter), 40rem);
      max-height: 90svh;
      margin: auto;
      padding: var(--space-10);
      border-radius: var(--radius-card);
    }
    .cdlg__actions {
      flex-direction: row;
      justify-content: flex-end;
    }
  }
  @media (min-width: 1100px) {
    .cbanner__card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-10);
    }
    .cbanner__text {
      max-width: 38.875rem; /* 622 */
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cbanner,
    .cbanner.is-visible {
      transform: none;
      transition: opacity var(--dur) linear;
    }
    .switch,
    .switch::before {
      transition: none;
    }
  }
</style>
