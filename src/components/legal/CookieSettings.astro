---
// Markdoc {% cookie-settings /%}: кнопка «Paramètres cookies» (Outline) — відкриває те саме вікно, що у футері.
// Немає категорій зі згодою — кнопки немає (вікна теж немає).
import Button from '../ui/Button.astro';
import { consentCategories, getSettings } from '../../content/helpers';
import { t, type Locale } from '../../i18n/utils';

const lang = Astro.params.lang as Locale;
const show = consentCategories(await getSettings()).length > 0;
---

{show && (
  <p class="legal-action">
    <Button variant="outline" data-consent-open="">
      {t('cookies.settings', lang)}
    </Button>
  </p>
)}

<style>
  .legal-action {
    margin-block: var(--space-2);
  }
</style>
