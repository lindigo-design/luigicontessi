---
// Figma: Yachts → 03 Yachts disponibles (desktop 36:431, mobile 37:524). id="disponibles", фон --color-bg-alt.
// Заголовок + фільтри за довжиною (радіо-чипи; mobile — горизонтальна прокрутка) → «À la une» (фото на весь
// фон, градієнт знизу) → картки (уся картка — одне посилання) → Off-market. Фільтр ховає картки без
// перезавантаження і пише ?taille=… в адресу (src/scripts/yachts.ts). Демо-яхти — з плашкою «Illustration».
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../../ui/Button.astro';
import YachtCard from './YachtCard.astro';
import { yachtHref, yachtPrice, yachtSpecs } from '../../../content/helpers';
import { t, type Locale } from '../../../i18n/utils';
import type { YachtsPageData } from '../../../content.config';

interface Yacht {
  slug: string;
  name: string;
  length: number;
  year: number | null;
  cabins: number | null;
  price: number | null;
  featured: boolean;
  image: ImageMetadata;
  imageAlt: Record<Locale, string>;
  demo: boolean;
}
interface Props {
  lang: Locale;
  data: YachtsPageData['available'];
  yachts: Yacht[];
  /** Демо-режим: на фото плашка «Illustration». */
  demoLabel?: string;
}
const { lang, data, yachts, demoLabel } = Astro.props;
const featured = yachts.find((y) => y.featured);
const others = yachts.filter((y) => y !== featured);
const sizes = ['all', 'lt30', '30-50', 'gt50'] as const;
const sizeOf = (y: Yacht) => (y.length < 30 ? 'lt30' : y.length <= 50 ? '30-50' : 'gt50');
const specs = (y: Yacht) => yachtSpecs(y, lang);
const price = (y: Yacht, onRequest: string) => yachtPrice(y, lang, onRequest);
---

<section
  class="yavail section section--alt"
  id="disponibles"
  aria-labelledby="yavail-title"
  data-yachts
>
  <div class="container yavail__inner">
    <div class="yavail__head">
      <div class="section-head__text">
        <p class="eyebrow">{data.eyebrow}</p>
        <h2 id="yavail-title">{data.title}</h2>
      </div>
      {yachts.length > 0 && (
        <fieldset class="yfilter">
          <legend class="visually-hidden">{data.filters.legend}</legend>
          <div class="yfilter__list">
            {sizes.map((s) => (
              <label class="yfilter__item">
                <input
                  class="visually-hidden"
                  type="radio"
                  name="taille"
                  value={s}
                  checked={s === 'all'}
                  data-yacht-filter
                />
                <span class="chip">{s === 'all' ? data.filters.all : data.filters[s]}</span>
              </label>
            ))}
          </div>
        </fieldset>
      )}
    </div>

    {featured && (
      <article class="yfeat zoom-card" data-yacht={sizeOf(featured)}>
        <div class="yfeat__img media">
          <Image
            src={featured.image}
            alt={featured.imageAlt[lang]}
            widths={[720, 1280, 1920, 2400]}
            sizes="(min-width: 1440px) 1280px, 100vw"
            loading="lazy"
          />
        </div>
        {featured.demo && demoLabel && <p class="ydemo text-s">{demoLabel}</p>}
        <div class="yfeat__content">
          <div class="yfeat__text">
            <p class="eyebrow">{data.featured}</p>
            <h3 class="yfeat__name">{featured.name}</h3>
            <dl class="yfeat__specs">
              {[
                ...specs(featured),
                {
                  label: t('yachts.price', lang),
                  value: price(featured, t('yachts.onRequest', lang)),
                },
              ].map((s) => (
                <div>
                  <dt class="eyebrow eyebrow--muted">{s.label}</dt>
                  <dd class="title">{s.value}</dd>
                </div>
              ))}
            </dl>
          </div>
          <Button href={yachtHref(featured.slug, lang)} class="yfeat__cta">
            {t('yachts.discover', lang)}
            <span class="visually-hidden"> — {featured.name}</span>
          </Button>
        </div>
      </article>
    )}

    {others.length > 0 && (
      <ul class="ycards" role="list">
        {others.map((y) => (
          <YachtCard lang={lang} yacht={y} demoLabel={demoLabel} size={sizeOf(y)} />
        ))}
      </ul>
    )}

    {yachts.length > 0 && (
      <p class="yavail__empty text-2" data-yacht-empty hidden>
        {data.empty} <a href="#off-market">{data.emptyLink}</a>
      </p>
    )}

    <div class="yoff" id="off-market">
      <div class="yoff__text">
        <p class="eyebrow eyebrow--muted">{data.offMarket.eyebrow}</p>
        <h3 class="yoff__title">{data.offMarket.title}</h3>
        {data.offMarket.textShort ? (
          <>
            <p class="yoff__body yoff__body--short text-2">{data.offMarket.textShort}</p>
            <p class="yoff__body yoff__body--long text-2">{data.offMarket.text}</p>
          </>
        ) : (
          <p class="yoff__body text-2">{data.offMarket.text}</p>
        )}
      </div>
      <Button href="?topic=off-market#demande" variant="outline" class="yoff__cta">
        {data.offMarket.cta.label}
      </Button>
    </div>
  </div>
</section>

<script>
  import { initYachtFilters } from '../../../scripts/yachts';
  initYachtFilters();
</script>

<style>
  .yavail__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .yavail__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  /* Фільтри: mobile — горизонтальна прокрутка без переносу й без скролбару. */
  .yfilter {
    min-width: 0;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0;
    border: 0;
  }
  .yfilter__list {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
    padding-inline: var(--gutter);
  }
  .yfilter__list::-webkit-scrollbar {
    display: none;
  }
  .yfilter__item {
    flex: none;
    cursor: pointer;
  }
  .yfilter__item input:checked + :global(.chip) {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-on-light);
  }
  .yfilter__item input:focus-visible + :global(.chip) {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }
  [data-yacht][hidden],
  .yavail__empty[hidden] {
    display: none;
  }
  .yavail__empty a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Плашка «Illustration» (демо-яхти): лівий верхній кут фото. */
  .ydemo {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 1;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-btn);
    background: rgb(var(--shade) / 0.6);
  }

  /* «À la une»: фото на весь фон, градієнт знизу, вміст унизу. */
  .yfeat {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 26.25rem; /* 420 */
    overflow: hidden;
    border-radius: var(--radius-card);
    isolation: isolate;
  }
  .yfeat__img {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .yfeat::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* Mobile: текст займає більшу частину картки — фото лише вгорі (65 %), нижче темне тло;
       затемнення плавно переходить з фото в тло, текст читається, яхту видно над ним. */
    background: linear-gradient(
      to bottom,
      rgb(var(--shade) / 0) 0%,
      rgb(var(--shade) / 0) 36%,
      rgb(var(--shade) / 0.85) 56%,
      rgb(var(--shade) / 1) 66%
    );
  }
  .yfeat {
    background: var(--color-bg);
  }
  .yfeat__img {
    bottom: 34%;
  }
  .yfeat__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
  }
  .yfeat__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .yfeat__name {
    font-size: 1.75rem; /* 28 */
    line-height: var(--lh-h3);
  }
  .yfeat__specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
  }
  .yfeat__specs div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .yfeat :global(.yfeat__cta) {
    width: 100%;
  }

  /* Картки */
  .ycards {
    display: grid;
    gap: var(--space-10);
  }
  /* Off-market */
  .yoff {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .yoff__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .yoff__title {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  .yoff__body {
    font-size: var(--fs-body-s);
  }
  .yoff__body--long {
    display: none;
  }
  .yoff :global(.yoff__cta) {
    width: 100%;
  }

  @media (min-width: 768px) {
    .ycards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .yoff__body {
      font-size: var(--fs-body);
    }
    .yoff__body--long {
      display: block;
    }
    .yoff__body--short {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .yavail__inner {
      gap: var(--space-14);
    }
    .yavail__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .yfilter {
      margin: 0;
    }
    .yfilter__list {
      padding: 0;
      overflow: visible;
    }
    .yfeat {
      min-height: 38.75rem; /* 620 */
    }
    /* Desktop (Figma 40:552): градієнт лише знизу. */
    .yfeat::after {
      background: linear-gradient(
        to bottom,
        rgb(var(--shade) / 0) 0%,
        rgb(var(--shade) / 0) 45%,
        rgb(var(--shade) / 0.7) 75%,
        rgb(var(--shade) / 0.92) 100%
      );
    }
    .yfeat__img {
      bottom: 0;
    }
    .ydemo {
      top: var(--space-6);
      left: var(--space-6);
    }
    .yfeat__content {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-8);
      padding: var(--space-10) var(--space-12);
    }
    .yfeat__name {
      font-size: var(--fs-h2);
      line-height: var(--lh-h2);
    }
    .yfeat__specs {
      display: flex;
      gap: var(--space-8);
    }
    .yfeat :global(.yfeat__cta) {
      width: auto;
      flex: none;
    }
    .ycards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .yoff {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-10);
      padding: var(--space-12);
    }
    .yoff__text {
      max-width: 45rem; /* 720 */
    }
    .yoff :global(.yoff__cta) {
      width: auto;
      flex: none;
    }
  }
</style>
