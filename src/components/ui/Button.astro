---
// Figma: Button (Primary / Outline / Link / Link Accent).
// Правило сайту: червоний = дія. Link Accent — завжди з колом-стрілкою.
// Hover (Figma: State = Hover) лишає кнопку свого типу: Primary темнішає, Outline ледь підсвічується,
// Link сіріє, у Link Accent заливається коло. Лише з мишкою; клавіатура бачить той самий стан.
import ArrowCircle from './ArrowCircle.astro';
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'link' | 'accent';
  type?: 'button' | 'submit';
  block?: boolean;
  external?: boolean;
  /** Для партнерських посилань: 'sponsored noopener' (так Google бачить, що це реклама). */
  rel?: string;
  class?: string;
  tabindex?: number;
  title?: string;
  'aria-disabled'?: 'true';
  /** Коло-стрілка для Link (у Link Accent вона завжди). */
  arrow?: boolean;
  /** Посилання на файл, який завантажується (media kit PDF). */
  download?: boolean;
  /** Лише вигляд (span, aria-hidden): у картці, де посиланням є заголовок (Journal «Lire l'article»). */
  decorative?: boolean;
  [key: `data-${string}`]: string | undefined;
}
const {
  href,
  variant = 'primary',
  type = 'button',
  block = false,
  external = false,
  rel,
  arrow = false,
  download = false,
  decorative = false,
  class: extra,
  ...rest
} = Astro.props;
// href="" — теж посилання (на ту саму адресу, напр. «Réessayer» на 500).
const Tag = decorative ? 'span' : href !== undefined ? 'a' : 'button';
const cls = ['btn', `btn--${variant}`, block && 'btn--block', extra];
const linkAttrs = decorative
  ? { 'aria-hidden': 'true' as const }
  : href !== undefined
    ? {
        href,
        ...(external
          ? { target: '_blank', rel: rel ?? 'noopener noreferrer' }
          : rel
            ? { rel }
            : {}),
        ...(download ? { download: '' } : {}),
      }
    : { type };
---

<Tag class:list={cls} {...linkAttrs} {...rest}>
  <span class="btn__label">
    <slot />
  </span>
  {(variant === 'accent' || arrow) && <ArrowCircle />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 3.25rem;
    padding: 1.125rem 1.75rem;
    border-radius: var(--radius-btn);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-label);
    line-height: 1.23;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .btn--primary {
    background: var(--color-text);
    color: var(--color-on-light);
  }
  .btn--outline {
    border: 1px solid var(--color-text);
    color: var(--color-text);
    padding-block: 1.0625rem;
  }
  .btn--link,
  .btn--accent {
    min-height: 2.75rem;
    padding: 0.125rem 0;
    gap: var(--space-4);
  }
  .btn--link {
    color: var(--color-text);
  }
  .btn--accent {
    color: var(--color-red-text);
  }
  .btn--block {
    width: 100%;
  }

  /* Hover — лише з мишкою, щоб на телефоні кнопка не «залипала» після дотику. */
  @media (hover: hover) {
    .btn--primary:hover {
      background: var(--color-primary-hover);
    }
    .btn--outline:hover {
      background: var(--color-hover-tint);
    }
    .btn--link:hover {
      color: var(--color-text-2);
    }
    .btn--accent:hover :global(.arrow) {
      background: var(--color-red-text);
      color: var(--color-bg);
    }
  }
  .btn--primary:focus-visible {
    background: var(--color-primary-hover);
  }
  .btn--outline:focus-visible {
    background: var(--color-hover-tint);
  }
  .btn--link:focus-visible {
    color: var(--color-text-2);
  }
  .btn--accent:focus-visible :global(.arrow) {
    background: var(--color-red-text);
    color: var(--color-bg);
  }
  /* Натиснуто — легкий «клік». */
  .btn--primary:active,
  .btn--outline:active {
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
    .btn--primary:active,
    .btn--outline:active {
      transform: none;
    }
  }
</style>
