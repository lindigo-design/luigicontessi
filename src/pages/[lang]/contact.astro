---
// Сторінка «Contact»: /<мова>/contact/. Заголовок + варіанти зв'язку + форма «Autre question» (крок C).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactMain from '../../components/sections/contact/ContactMain.astro';
import ContactForm from '../../components/sections/contact/ContactForm.astro';
import ContactPhoto from '../../components/sections/contact/ContactPhoto.astro';
import { getContact, getEmail, getSettings } from '../../content/helpers';
import { locales, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const page = await getContact(lang);
const settings = await getSettings();
---

<BaseLayout lang={lang} title={page.seoTitle} description={page.seoDescription} current="contact">
  <ContactMain
    lang={lang}
    data={page}
    pressEmail={getEmail(settings, 'press')}
    instagram={{ handle: settings.instagramHandle, url: settings.instagramUrl }}
  >
    <ContactForm lang={lang} data={page.form} email={getEmail(settings, 'contact')} />
  </ContactMain>
  <ContactPhoto />
</BaseLayout>
