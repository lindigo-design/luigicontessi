---
// Figma: Home → 03 Citation (desktop 3:71, mobile 6:240). Цитата на фото.
import { Image } from 'astro:assets';
import bg from '../../../assets/img/home/quote.jpg';
import type { HomeData } from '../../../content.config';

interface Props {
  data: HomeData['quote'];
}
const { data } = Astro.props;
---

<section class="quote" aria-label={data.author}>
  <Image
    class="quote__bg"
    src={bg}
    alt={data.image.alt}
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
  />
  <div class="container">
    <figure class="quote__card">
      <blockquote>
        <p>{data.text}</p>
      </blockquote>
      <figcaption class="eyebrow eyebrow--muted">{data.author}</figcaption>
    </figure>
  </div>
</section>

<style>
  /* Висота як у Figma (388 → 738), картка по центру. Відступи — на випадок довшої цитати (EN/IT). */
  .quote {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: clamp(24.25rem, 16.125rem + 33.333vw, 46.125rem); /* 388 → 738 */
    padding-block: clamp(6rem, 4.629rem + 5.714vw, 10rem); /* 96 → 160 */
    background: var(--color-image);
  }
  .quote__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  .quote__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    max-width: 55rem;
    margin-inline: auto;
    padding: clamp(2rem, 1.314rem + 2.857vw, 4.5rem);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    text-align: center;
  }
  blockquote p {
    font-family: var(--font-display);
    font-size: var(--fs-quote);
    line-height: 1.333; /* Mobile/Quote 24/32 */
    letter-spacing: -0.01em;
  }
  /* Повноширинне фото (правило з CLAUDE.md): з 1024 висота росте з шириною — 1440 → 738 (51.25vw),
     1920 → 984, але не вище за вікно. */
  @media (min-width: 1024px) {
    .quote {
      min-height: min(100svh, max(46.125rem, 51.25vw));
    }
    /* Кадр як у Figma (desktop) */
    .quote__bg {
      object-position: 50% 59%;
    }
    blockquote p {
      line-height: 1.278; /* Desktop/Quote 36/46 */
    }
    .quote__card {
      gap: var(--space-8);
    }
  }
  /* Висота секції вже не росте, а фото (вертикальне) збільшується з шириною — видима смуга вужчає.
     Трохи піднімаємо кадр, щоб лишались двигун літака і передня частина авто, як на 1440. */
  @media (min-width: 1600px) {
    .quote__bg {
      object-position: 50% 52%;
    }
  }
</style>
