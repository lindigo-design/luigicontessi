---
// Figma: Fiche yacht → 01 Le yacht (desktop 38:475, mobile 39:562).
// Desktop: «Le yacht» | заголовок (до першої коми — білим, далі — сірим); під ними головне фото 600 × 420
// з плашкою «Vendu par {продавець}» і праворуч вступ + фото біля головного, притиснуті донизу.
// Mobile: заголовок і вступ першими, фото — свайп-стрічка (головне — перше), крапки
// (src/scripts/gallery.ts, як на Privilèges). Розмітка одна, на desktop стрічка стає сіткою.
// Клік по фото — на весь екран (Lightbox, спільна галерея сторінки).
import type { ImageMetadata } from 'astro';
import YachtPhoto from './YachtPhoto.astro';
import LightboxTrigger from '../../ui/LightboxTrigger.astro';
import { t, type Locale } from '../../../i18n/utils';

interface Props {
  lang: Locale;
  name: string;
  image: ImageMetadata;
  imageAlt: string;
  headline: string;
  intro: string;
  gallery: { image?: ImageMetadata; label: string }[];
  /** Назва продавця або '' — тоді без плашки «Vendu par». */
  partner: string;
  demoLabel?: string;
}
const { lang, name, image, imageAlt, headline, intro, gallery, partner, demoLabel } = Astro.props;
// Заголовок: до першої коми — основним кольором, решта — сірим (як у Figma).
const comma = headline.indexOf(',');
const [lead, rest] =
  comma > 0 ? [headline.slice(0, comma + 1), headline.slice(comma + 1)] : [headline, ''];
const slides = [{ image, label: '' }, ...gallery];
const total = slides.length;
---

<section class:list={['yover', `yover--g${gallery.length}`]} aria-label={t('yachts.leYacht', lang)}>
  <div class="container yover__inner">
    <div class="yover__head">
      <p class="yover__label" aria-hidden="true">
        {t('yachts.leYacht', lang)}
      </p>
      {headline && (
        <h2 class="yover__headline">
          {lead}
          {rest && <span class="text-2">{rest}</span>}
        </h2>
      )}
    </div>

    <div class="yover__grid" data-gallery>
      {intro && <p class="yover__intro text-2">{intro}</p>}
      <ul
        class="yover__track"
        role="list"
        aria-label={t('yachts.gallery', lang)}
        data-gallery-track
      >
        {slides.map((s, i) => (
          <li class:list={['yover__slide', { 'yover__slide--main': i === 0 }]} data-gallery-slide>
            <YachtPhoto
              image={s.image}
              alt={i === 0 ? imageAlt : `${name} — ${s.label}`}
              label={s.label}
              demoLabel={demoLabel}
              widths={i === 0 ? [600, 900, 1200, 1800] : [320, 480, 640, 960]}
              sizes={i === 0 ? '(min-width: 768px) 42vw, 85vw' : '(min-width: 768px) 22vw, 85vw'}
              loading={i === 0 ? 'eager' : 'lazy'}
              class="yover__photo"
            >
              {i === 0 && partner && (
                <p class="yover__badge">
                  <span class="text-s text-2">{t('yachts.soldBy', lang)}</span>
                  <span class="eyebrow">{partner}</span>
                </p>
              )}
              <LightboxTrigger lang={lang} image={s.image} title={i === 0 ? name : s.label} />
            </YachtPhoto>
          </li>
        ))}
      </ul>
      {total > 1 && (
        <div class="yover__dots">
          {slides.map((_, i) => (
            <button
              class:list={['yover__dot', { 'is-active': i === 0 }]}
              type="button"
              aria-label={`${t('ui.photo', lang)} ${i + 1} ${t('ui.of', lang)} ${total}`}
              aria-current={i === 0 ? 'true' : undefined}
              tabindex="-1"
              data-gallery-dot
            />
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<script>
  import { initGallery } from '../../../scripts/gallery';
  initGallery();
</script>

<style>
  .yover__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  /* Mobile: без «Le yacht» (Figma 39:562) — заголовок і вступ одразу. */
  .yover__label {
    display: none;
  }
  .yover__headline {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
  }
  .yover__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .yover__intro {
    max-width: 22.5rem; /* 360 */
  }
  /* Mobile: стрічка, слайд 85 % ширини — видно, що є наступне фото. */
  .yover__track {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  .yover__track::-webkit-scrollbar {
    display: none;
  }
  .yover__slide {
    flex: 0 0 85%;
    scroll-snap-align: start;
  }
  .yover :global(.yover__photo) {
    aspect-ratio: 358 / 300;
  }
  .yover__badge {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-btn);
    background: var(--color-card);
  }
  .yover__dots {
    display: flex;
    gap: var(--space-2);
    margin-top: calc(var(--space-3) * -1);
  }
  .yover__dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-border);
    transition: background-color var(--dur) var(--ease);
  }
  .yover__dot.is-active {
    background: var(--color-text);
  }
  /* Зона дотику крапки — 24 px (сама крапка 6). */
  .yover__dot {
    position: relative;
  }
  .yover__dot::after {
    content: '';
    position: absolute;
    inset: -0.5625rem;
  }

  /* ≥ 768: сітка — головне фото ліворуч, праворуч вступ зверху і фото знизу. */
  @media (min-width: 768px) {
    .yover__inner {
      gap: var(--space-12);
      padding-top: var(--space-10);
      padding-bottom: var(--space-24);
    }
    /* Заголовок і нижня сітка — на одних колонках (--cols), тож заголовок стоїть рівно над вступом
       «Un yacht à moteur…», а «Le yacht» — над головним фото. */
    .yover {
      --cols: minmax(0, 600fr) repeat(2, minmax(0, 316fr));
    }
    .yover--g3 {
      --cols: minmax(0, 600fr) repeat(3, minmax(0, 211fr));
    }
    .yover--g0,
    .yover--g1 {
      --cols: minmax(0, 600fr) minmax(0, 656fr);
    }
    .yover__head {
      display: grid;
      grid-template-columns: var(--cols);
      column-gap: var(--space-6);
      align-items: start;
    }
    .yover__headline {
      grid-column: 2 / -1;
    }
    .yover__label {
      display: block;
      padding-left: var(--space-24);
      font-family: var(--font-display);
      font-size: var(--fs-h3);
      line-height: var(--lh-h3);
    }
    .yover__grid {
      display: grid;
      grid-template-columns: var(--cols);
      grid-template-rows: auto 1fr;
      gap: var(--space-6);
    }
    .yover__track {
      display: contents;
    }
    .yover__intro {
      grid-column: 2 / -1;
      grid-row: 1;
    }
    .yover__slide {
      grid-row: 2;
      align-self: end;
    }
    .yover__slide--main {
      grid-column: 1;
      grid-row: 1 / span 2;
      align-self: stretch;
    }
    .yover :global(.yover__photo) {
      aspect-ratio: 316 / 252;
    }
    .yover__slide--main :global(.yover__photo) {
      aspect-ratio: 600 / 420;
    }
    .yover__dots {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .yover__badge {
      left: var(--space-5);
      bottom: var(--space-5);
    }
  }
</style>
