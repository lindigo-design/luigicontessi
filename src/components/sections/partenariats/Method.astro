---
// Figma: Partenariats → 04 Méthode (desktop 47:503). Фон --color-bg-alt. 4 кроки — спільний ui/Steps.
import Steps from '../../ui/Steps.astro';
import type { PartenariatsData } from '../../../content.config';

interface Props {
  data: PartenariatsData['method'];
}
const { data } = Astro.props;
---

<section class="method section section--alt" aria-labelledby="method-title">
  <div class="container method__inner">
    <div class="section-head__text">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2 id="method-title">{data.title}</h2>
    </div>
    <Steps steps={data.steps} />
  </div>
</section>

<style>
  .method__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  @media (min-width: 1024px) {
    .method__inner {
      gap: var(--space-14);
    }
  }
</style>
