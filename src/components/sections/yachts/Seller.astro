---
// Figma: Yachts → 05 Le vendeur (desktop 36:535, mobile 37:597). Фон --color-bg-alt.
// Логотип 240 × 96 (mobile 160 × 64, над текстом) + текст: eyebrow → назва → опис → юридичні дані →
// «Site de {name}» (нова вкладка). Секція — коли в settings.json → yachtPartner.name заповнено,
// або в перегляді (isPreview): тоді порожні поля — заглушки з Figma («[Société]», плашка «LOGO»,
// посилання-заглушка «Lien bientôt disponible»). На живому сайті без продавця секції немає.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../../ui/Button.astro';
import PageLink from '../../ui/PageLink.astro';
import { t, type Locale } from '../../../i18n/utils';
import type { YachtsPageData } from '../../../content.config';

interface Props {
  lang: Locale;
  data: YachtsPageData['seller'];
  partner: { name: string; about: string; legal: string; url: string };
  logo: ImageMetadata | null;
  /** Перегляд: порожні поля — заглушки з Figma. */
  preview?: boolean;
}
const { lang, data, partner, logo, preview = false } = Astro.props;
const demo = (filled: string, key: Parameters<typeof t>[0]) =>
  filled || (preview ? t(key, lang) : '');
const name = demo(partner.name, 'seller.demo.name');
const about = demo(partner.about, 'seller.demo.about');
const legal = demo(partner.legal, 'seller.demo.legal');
---

<section class="seller section section--alt" aria-labelledby="seller-title">
  <div class="container seller__row">
    {logo ? (
      <div class="seller__logo">
        <Image src={logo} alt="" widths={[240, 480]} sizes="(min-width: 768px) 240px, 160px" />
      </div>
    ) : (
      preview && (
        <div class="seller__logo seller__logo--demo" aria-hidden="true">
          <span class="eyebrow eyebrow--muted">{t('seller.demo.logo', lang)}</span>
        </div>
      )
    )}
    <div class="seller__text">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2 id="seller-title" class="seller__name">
        {name}
      </h2>
      {about && <p class="text-2">{about}</p>}
      {legal && <p class="text-s text-2">{legal}</p>}
      {partner.url ? (
        <Button href={partner.url} variant="accent" external rel="noopener">
          {data.link.replace('{name}', name)}
          <span class="visually-hidden"> {t('ui.newWindow', lang)}</span>
        </Button>
      ) : (
        preview && (
          <PageLink lang={lang} label={data.link.replace('{name}', name)} path="__soon__" />
        )
      )}
    </div>
  </div>
</section>

<style>
  /* Перегляд без логотипа: сіра плашка «LOGO [SOCIÉTÉ]». */
  .seller__logo--demo {
    display: grid;
    place-items: center;
    border-radius: var(--radius-card);
    background: var(--color-image);
    text-align: center;
  }
  .seller__row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .seller__logo {
    width: 10rem; /* 160 × 64 */
    height: 4rem;
  }
  .seller__logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
  }
  .seller__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    min-width: 0;
  }
  .seller__name {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  @media (min-width: 768px) {
    .seller__row {
      flex-direction: row;
      align-items: center;
      gap: var(--space-16);
    }
    .seller__logo {
      flex: none;
      width: 15rem; /* 240 × 96 */
      height: 6rem;
    }
  }
</style>
