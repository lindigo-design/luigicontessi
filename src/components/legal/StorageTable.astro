---
// Markdoc {% storage-table /%}: таблиця cookies / stockage local — з коду (storageInventory), а не вручну,
// щоб не розходилась із тим, що сайт справді зберігає.
import { getSettings, storageInventory } from '../../content/helpers';
import { t, type Locale } from '../../i18n/utils';

const lang = Astro.params.lang as Locale;
const rows = storageInventory(await getSettings(), lang);
---

<div class="legal-table">
  <table>
    <thead>
      <tr>
        <th scope="col">{t('storage.name', lang)}</th>
        <th scope="col">{t('storage.purpose', lang)}</th>
        <th scope="col">{t('storage.duration', lang)}</th>
        <th scope="col">{t('storage.type', lang)}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td>
            <code>{r.name}</code>
          </td>
          <td>{r.purpose}</td>
          <td>{r.duration}</td>
          <td>{r.type}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
