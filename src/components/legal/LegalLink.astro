---
// Markdoc {% legal-link path="confidentialite" /%}: посилання на юридичну сторінку з legalNav (назва — з i18n).
// Сторінка ще не готова (isBuilt) — просто назва без посилання.
import { isBuilt, legalNav } from '../../i18n/nav';
import { localizePath, t, type Locale } from '../../i18n/utils';

interface Props {
  path: string;
}
const { path } = Astro.props;
const lang = Astro.params.lang as Locale;
const item = legalNav.find((i) => i.path === path);
if (!item) throw new Error(`legal-link: немає сторінки «${path}» у legalNav`);
const label = `« ${t(item.key, lang)} »`;
---

{isBuilt(path) ? <a href={localizePath(path, lang)}>{label}</a> : <span>{label}</span>}
