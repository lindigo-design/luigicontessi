---
// Figma: Home → 03b Presse (desktop 59:396, mobile 59:456).
// Логотипи медіа нерухомі (не стрічка) — так домовились.
// Картка: мета → фото (якщо є; пропорція 355 / 139, кадр — imagePosition через CSS-змінну, CSP) →
// заголовок → цитата → кнопка. Hover картки (світло за курсором) + легкий зум фото.
// Фото — тимчасові ілюстрації; для справжніх статей — фото з публікації або кадр з репортажу.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from '../../ui/Button.astro';

interface Props {
  data: CollectionEntry<'home'>['data']['press'];
  href: string;
}
const { data, href } = Astro.props;
---

<section class="press section" aria-labelledby="press-title">
  <div class="container press__inner">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">{data.eyebrow}</p>
        <h2 id="press-title">{data.title}</h2>
      </div>
      <Button href={href} variant="accent">
        {data.link.label}
      </Button>
    </div>
    <ul class="press__cards rail" role="list">
      {data.items.map((item) => (
        <li class="pcard hover-card zoom-card">
          <p class="eyebrow eyebrow--muted">{item.meta}</p>
          {item.image && (
            <div class="pcard__img media" data-position={item.imagePosition || undefined}>
              <Image
                src={item.image}
                alt=""
                widths={[360, 720, 1080]}
                sizes="(min-width: 1024px) 26vw, 300px"
                loading="lazy"
              />
            </div>
          )}
          <h3>{item.title}</h3>
          <p class="pcard__excerpt text-s text-2">{item.excerpt}</p>
          <Button href={href} variant="accent" class="hover-card__link">
            {item.action}
          </Button>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Кадр фото з даних (напр. «50% 87%») — через CSS-змінну (inline-стилі заборонені CSP).
  document.querySelectorAll<HTMLElement>('.pcard__img[data-position]').forEach((el) => {
    el.style.setProperty('--position', el.dataset.position ?? '');
  });
</script>

<style>
  .press__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .pcard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    width: 18.75rem;
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .pcard__img {
    align-self: stretch;
    aspect-ratio: 355 / 139;
    border-radius: var(--radius-card);
  }
  .pcard__img :global(img) {
    object-position: var(--position, 50% 50%);
  }
  /* Цитата займає вільне місце — кнопки в ряду на одній лінії, картки однакової висоти. */
  .pcard__excerpt {
    flex: 1;
  }
  @media (min-width: 1024px) {
    .press__inner {
      gap: var(--space-12);
    }
    .press__cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    .pcard {
      width: auto;
      padding: var(--space-7);
    }
  }
</style>
